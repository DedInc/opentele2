 "meta": {
  "generator": "scripts/gen_core_vectors.py",
  "legacy": "tdata_legacy/<name>: a pre-7.3 folder (key file without the 7.3 trailer, the local key bytes(tdata_legacy/<name>/local_key, 256) wrapped under Storage.CreateLocalKey(bytes(tdata_legacy/<name>/salt, 32), passcode)) whose accounts and key file 1.5.0's TDesktop.__writeAccounts writes with performance mode off; tdata_legacy/<name>_saved: what 1.5.0 SaveTData writes after loading it with performance mode on (the migrated key file)",
  "loader": "src.td.TDesktop(folder, passcode=passcode) under the same mode",
  "pattern": "bytes(label, n): SHA-256(utf8(label) || counter as u32 big-endian) for counter = 0, 1, 2, ..., concatenated and cut to n bytes",
  "rng": "os.urandom is replaced by one bytes(label, ...) stream per vector; each call takes the next len bytes of that stream",
  "source_version": "1.5.0"
 }
