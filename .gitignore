# Real accounts used by the test suite; must never be committed.
tests/data/

# Local-only material: reference checkouts and working notes.
refs/
docs/

# Editor settings.
.vscode/*

# Python virtual environments.
.venv/
.venv*/
venv/

# Python bytecode and tool caches.
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage

# Rust build output; the workspace lockfile stays tracked.
/target/
bindings/python/target/
!/Cargo.lock

# Python packaging output from bindings/python.
dist/
*.egg-info/
*.whl

# Node binding dependencies, native addons and packed tarballs.
node_modules/
*.node
*.tgz

# The documentation site, a separate repository checked out here.
opentele2.github.io/
