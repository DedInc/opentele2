{
  "name": "opentele2",
  "version": "2.0.0",
  "description": "Telegram Desktop tdata formats, crypto, string sessions and API fingerprints from the Rust core of opentele2, with mtcute helpers",
  "keywords": [
    "telegram",
    "tdata",
    "tdesktop",
    "opentele",
    "mtcute",
    "napi-rs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DedInc/opentele2.git",
    "directory": "bindings/node"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./mtcute": {
      "types": "./mtcute.d.ts",
      "default": "./mtcute.mjs"
    },
    "./telethon": {
      "types": "./telethon.d.ts",
      "default": "./telethon.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "tdata-types.d.ts",
    "mtcute.mjs",
    "mtcute.d.ts",
    "telethon.mjs",
    "telethon.d.ts"
  ],
  "napi": {
    "binaryName": "opentele2",
    "dtsHeader": "/* auto-generated by NAPI-RS */\n/* eslint-disable */\n\nexport type { DcEndpoints, Endpoint, Endpoints, MtpConfig, MtpConfigFields, ProtocolEndpoints, RsaPublicKey } from './tdata-types'\n",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "create-npm-dirs": "napi create-npm-dirs",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node --test __test__",
    "typecheck": "tsc --noEmit -p __test__/tsconfig.json",
    "version": "napi version"
  },
  "peerDependencies": {
    "@mtcute/core": ">=0.32.0",
    "@mtcute/node": ">=0.32.0"
  },
  "peerDependenciesMeta": {
    "@mtcute/core": {
      "optional": true
    },
    "@mtcute/node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mtcute/core": "0.32.5",
    "@mtcute/node": "0.32.5",
    "@napi-rs/cli": "3.10.8",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.33.0"
}
